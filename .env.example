# ── Obligatorias ──────────────────────────────────────────────
# Clave del proveedor del modelo (valor ficticio; use la suya en .env, que NO se sube al repositorio)
ANTHROPIC_API_KEY=sk-ant-REEMPLAZAR
# Claves que los clientes deben enviar en X-API-Key (separadas por coma). Genere una con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# (Esta clave de ejemplo es pública: si la deja sin cambiar, el servidor la rechaza y responde 503.)
API_KEYS=clave-ficticia-cambiar-por-una-larga-y-aleatoria

# ── Opcionales ────────────────────────────────────────────────
# Modelo de los especialistas (usan herramientas y entregan cifras): Sonnet por defecto
MODELO=claude-sonnet-5-5
# Modelo del enrutador, el Coordinador y la conclusión integrada. Vacío = claude-haiku-5-5 (más económico)
MODELO_ROUTER=
# Modo económico: Haiku TAMBIÉN en los especialistas + topes menores. Solo para desarrollo (puede omitir datos). 1 = activar
ECONOMICO=0
# Topes de longitud de respuesta (si se corta, se avisa) y mensajes de historial que se envían al modelo
MAX_TOKENS=2500
MAX_TOKENS_AUX=1500
HISTORIAL_MAX_MENSAJES=24
# Caché de prompts de Anthropic (0 = desactivar)
PROMPT_CACHE=1
# URL pública del servicio (aparece en las Agent Cards). Local: http://127.0.0.1:8000 | Heroku: https://<tu-app>.herokuapp.com
PUBLIC_URL=http://127.0.0.1:8000
# URL con la que el servicio se llama a sí mismo por A2A (por defecto http://127.0.0.1:$PORT; no hace falta tocarla)
# INTERNAL_URL=
# Control de costos: consultas por minuto y por clave en /chat y /api/consulta (0 = sin límite)
RATE_LIMIT_PER_MIN=20
# Segundos máximos que se espera a cada agente
A2A_TIMEOUT=90

# ── Canal Telegram (opcional; sin token queda desactivado) ──
# Token de @BotFather (secreto: no lo suba al repositorio)
TELEGRAM_BOT_TOKEN=
# IDs numéricos de Telegram autorizados a usar el bot, separados por coma (obtenga el suyo con @userinfobot)
TELEGRAM_ALLOWED_IDS=
# Secreto que Telegram envía al webhook (python -c "import secrets; print(secrets.token_urlsafe(24))")
TELEGRAM_WEBHOOK_SECRET=
# auto: webhook si PUBLIC_URL es https y apagado si no | webhook | polling (pruebas locales) | off
TELEGRAM_MODO=auto

# ── Persistencia de la memoria de los agentes y del historial (avanzado; normalmente no hace falta tocarlo) ──
# Sin nada: SQLite local en data/agentes.db. Con Heroku Postgres, Heroku define DATABASE_URL solo y se usa Postgres.
# DATABASE_URL=
# Carpeta del archivo SQLite local
# DATA_DIR=data
# memoria = no guarda nada en disco (pruebas)
# PERSISTENCIA=auto

# ── Evaluación y capturas (opcional) ──
# Clave que usa `python -m evaluacion.evaluar` si no se pasa --key (por defecto toma la primera de API_KEYS)
# EVAL_API_KEY=

# Agentes A2A de otras personas/servicios (JSON en una línea). Se suman al selector y colaboran con los locales.
# Ejemplo: [{"id":"agente_czz","nombre":"Carlos Zapata","especialidad":"análisis de acciones","card_url":"https://host/.well-known/agent-card.json","api_key":"clave-del-otro-servicio"}]
A2A_EXTERNOS=
